{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapaMotion",
  "version": "0.8.0",
  "identifier": "com.capamotion.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CapaMotion",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "CapaMotion",
    "shortDescription": "Local Roblox animation studio",
    "longDescription": "Local-first Roblox animation editor with AI motion tooling.",
    "fileAssociations": [
      {
        "ext": ["rma"],
        "name": "CapaMotion Project",
        "description": "CapaMotion animation project",
        "mimeType": "application/x-capamotion-project"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": { "language": "en-US" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
